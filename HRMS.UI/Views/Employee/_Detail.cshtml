<!-- Job History Details Modal -->
<div class="modal fade" id="jobHistoryModal" tabindex="-1" aria-labelledby="jobHistoryLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="jobHistoryLabel">Job History Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table table-bordered">
                    <tr><th>Employee</th><td id="modalEmployeeName"></td></tr>
                    <tr><th>Manager</th><td id="modalManagerName"></td></tr>
                    <tr><th>Job Role</th><td id="modalJobRole"></td></tr>
                    <tr><th>Start Date</th><td id="modalStartDate"></td></tr>
                    <tr><th>End Date</th><td id="modalEndDate"></td></tr>
                    <tr><th>Status</th><td id="modalStatus"></td></tr>
                    <tr><th>Comments</th><td id="modalComments"></td></tr>
                </table>
            </div>
        </div>
    </div>
</div>