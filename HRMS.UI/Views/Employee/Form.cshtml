@model HRMS.Models.View.EmployeeModel

@{
    Layout = "_Layout";
    bool isEdit = Model?.Id > 0;
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header @(isEdit ? "bg-warning" : "bg-primary") text-white text-center">
                <h5 class="mb-0">@(isEdit ? "Edit Employee" : "Create Employee")</h5>
            </div>
            <div class="card-body p-4">
               @*  @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong>Success: </strong> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                } *@
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Error:</strong> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }


                <form asp-controller="Employee" asp-action="@(isEdit ? "Edit" : "Create")" method="post">
                    @Html.AntiForgeryToken()

                    @if (isEdit)
                    {
                        <input type="hidden" asp-for="Id" />
                    }

                    <div class="mb-2">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control form-control-sm" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="BirthDate" class="form-label"></label>
                        <input asp-for="BirthDate" type="date" class="form-control form-control-sm" required />
                    </div>

                    <div class="mb-2">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control form-control-sm" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" type="email" class="form-control form-control-sm" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender" class="form-control form-control-sm">
                            <option value="">Select</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control form-control-sm" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-control form-control-sm">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                            <option value="On Leave">On Leave</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-controller="Employee" asp-action="Index" class="btn btn-sm btn-secondary">Back</a>
                        <button type="submit" class="btn btn-sm @(isEdit ? "btn-warning" : "btn-primary")">
                            @(isEdit ? "Save Changes" : "Save")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}