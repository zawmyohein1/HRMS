@model HRMS.Models.Views.Setup.LocationModel

@{
    Layout = "_Layout";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center">
                <h5 class="mb-0">@(Model?.Id > 0 ? "Edit Location" : "Create Location")</h5>
            </div>
            <div class="card-body p-4">
               @*  @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong>Success: </strong> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                } *@
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Error:</strong> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-area="Setup" asp-controller="Location" asp-action="@(Model?.Id > 0 ? "Edit" : "Create")" method="post">

                    <!-- Hidden ID Field (Only for Edit) -->
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-2">
                        <label asp-for="Name" class="form-label">Location Name</label>
                        <input asp-for="Name" class="form-control form-control-sm" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="City" class="form-label">City</label>
                        <input asp-for="City" class="form-control form-control-sm" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Country" class="form-label">Country</label>
                        <input asp-for="Country" class="form-control form-control-sm" />
                        <span asp-validation-for="Country" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-controller="Location" asp-action="Index" class="btn btn-sm btn-secondary">Back</a>
                        <button type="submit" class="btn btn-sm btn-primary">@(Model?.Id > 0 ? "Update" : "Save")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
