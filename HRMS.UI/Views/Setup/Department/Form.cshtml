@model HRMS.Models.Views.Setup.DepartmentModel

@{
    Layout = "_Layout";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center">
                <h5 class="mb-0">@(Model?.Id > 0 ? "Edit Department" : "Create Department")</h5>
            </div>
            <div class="card-body p-4">
              @*   @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong>Success: </strong> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                } *@
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Error:</strong> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-controller="Department" asp-action="@(Model?.Id > 0 ? "Edit" : "Create")" method="post">

                    <!-- Hidden ID Field (Only for Edit) -->
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-2">
                        <label asp-for="Name" class="form-label">Department Name</label>
                        <input asp-for="Name" class="form-control form-control-sm" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control form-control-sm"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="LocationId" class="form-label">Location</label>
                        <select asp-for="LocationId" class="form-control form-control-sm">
                            <option value="">Select Location</option>
                            @foreach (var location in Model.Locations)
                            {
                                <option value="@location.Id">@location.Name</option>
                            }
                        </select>
                        <span asp-validation-for="LocationId" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-controller="Department" asp-action="Index" class="btn btn-sm btn-secondary">Back</a>
                        <button type="submit" class="btn btn-sm btn-primary">@(Model?.Id > 0 ? "Update" : "Save")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
